# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# --- WEBFORGE V10 / VERCEL REPLY PORTAL CONFIGURATION ---
# Admin Passcode for /admin dashboard authentication (Server-only, never NEXT_PUBLIC_*)
ADMIN_PASSCODE="solent-admin-2026"

# Upstash Redis REST credentials (from Vercel Storage Tab -> Create KV / Redis)
UPSTASH_REDIS_REST_URL="https://your-upstash-redis-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_rest_token_here"

# SMTP Mailer Settings (Nodemailer lazy singleton)
EMAIL_SERVER_HOST="smtp.zoho.eu"
EMAIL_SERVER_PORT="465"
EMAIL_SERVER_SECURE="true"
EMAIL_SERVER_USER="sales@solentmarineoutboards.co.uk"
EMAIL_SERVER_PASSWORD="your-app-specific-password"
EMAIL_FROM="sales@solentmarineoutboards.co.uk"

# Optional: Resend API Key (only if FORMS.provider is set to 'resend')
RESEND_API_KEY=""

