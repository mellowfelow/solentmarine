{
  "$schema": "https://modelcontextprotocol.io/schemas/server-card/v1.json",
  "serverInfo": {
    "name": "Solent Marine Outboards UK",
    "version": "1.0.0",
    "description": "UK's Premier Outboard Motors & Marine Engines Specialist",
    "homepage": "https://outboardmotors.co.uk",
    "contact": {
      "email": "sales@outboardmotors.co.uk",
      "whatsapp": "+447700900888",
      "phone": "+441983294400"
    }
  },
  "transport": {
    "type": "streamable-http",
    "endpoint": "https://outboardmotors.co.uk/api/mcp"
  },
  "capabilities": {
    "tools": [
      {
        "name": "search_products",
        "description": "Search outboard motors by keyword, brand, category, powerHp, shaft length, or max_price",
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": { "type": "string" },
            "brand": { "type": "string" },
            "category": { "type": "string" },
            "max_price": { "type": "number" }
          }
        }
      },
      {
        "name": "get_product",
        "description": "Get complete technical specifications of an outboard motor by its slug",
        "inputSchema": {
          "type": "object",
          "required": ["slug"],
          "properties": {
            "slug": { "type": "string" }
          }
        }
      },
      {
        "name": "list_categories",
        "description": "List all engine categories (portable, mid-range, high-hp, electric, 2-stroke commercial, parts)",
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "get_policies",
        "description": "Get shipping policies, PDI inspection procedures, UK warranty terms, and payment methods",
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "create_order_draft",
        "description": "Create prefilled outboard order draft. Human completes order via WhatsApp or dealership checkout.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "items": { "type": "array" },
            "shaftLength": { "type": "string" },
            "notes": { "type": "string" }
          }
        }
      }
    ],
    "resources": [
      {
        "name": "product-catalog",
        "description": "Full outboard motors catalog",
        "uri": "https://outboardmotors.co.uk/shop/"
      },
      {
        "name": "engine-specs-compare",
        "description": "Technical comparison matrix",
        "uri": "https://outboardmotors.co.uk/compare/"
      },
      {
        "name": "technical-faq",
        "description": "Shaft measurement and PDI guide",
        "uri": "https://outboardmotors.co.uk/faq/"
      }
    ],
    "commerce": {
      "ordering": "human-assisted-whatsapp-or-form",
      "payment": ["bacs-transfer", "debit-credit-card", "proforma-invoice", "marine-finance"],
      "currency": "GBP",
      "minimumOrder": "50.00",
      "freeShipping": "500.00"
    }
  },
  "legal": {
    "ageRestriction": "none",
    "productType": "marine-outboard-engines",
    "compliance": "UK Recreational Craft Regulations 2017 (RCD II)"
  }
}
